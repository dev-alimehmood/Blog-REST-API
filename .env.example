# Mini Blog API Environment Configuration Example
# Copy this file to .env and adjust variables as needed

# Django Secret Key (generate a strong random secret key for production)
SECRET_KEY=django-insecure-mini-blog-dev-secret-key-change-in-production-123456

# Debug mode (True for development, False for production)
DEBUG=True

# Allowed hosts (comma-separated list)
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# CORS / CSRF Trusted origins (if needed)
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

